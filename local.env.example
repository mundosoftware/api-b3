# Local backend runtime
APP_NAME="B3 Watch API"
DATABASE_PATH=database/app.db
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
HTTPS_ENABLED=true
HTTP_SERVER_PORT=80
HTTPS_SERVER_PORT=443
PUBLIC_SERVER_PORT=443
ENABLE_REVERSE_PROXY=auto
LETSENCRYPT_EMAIL=
LETSENCRYPT_STAGING=false
DEFAULT_TIMEZONE=America/Sao_Paulo
QUOTE_CACHE_TTL_SECONDS=60
CHECK_LOOP_SECONDS=30
CHECK_LOOP_ENABLED=true
HEALTH_CHECK_RETRIES=30
HEALTH_CHECK_INTERVAL_SECONDS=2
ONESIGNAL_ENABLED=true
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
ADMIN_TOKEN=change-me

# Local development overrides
LOCAL_VENV_DIR=venv
LOCAL_DATABASE_PATH=database/local-dev.db
LOCAL_SERVER_HOST=127.0.0.1
LOCAL_SERVER_PORT=8000
LOCAL_CHECK_LOOP_ENABLED=false
LOCAL_ONESIGNAL_ENABLED=false

# VPS deployment
VPS_HOST=203.0.113.10
VPS_USER=ubuntu
VPS_SSH_PORT=22
SSH_KEY_PATH=~/.ssh/id_ed25519
APP_DIR=/opt/b3-watch-api
SERVICE_NAME=b3-watch-api
APP_USER=ubuntu
UFW_ALLOW_PORT=80
HOST_FIREWALL_ALLOW_PORT=80
HOST_FIREWALL_ALLOW_PORTS=80,443
